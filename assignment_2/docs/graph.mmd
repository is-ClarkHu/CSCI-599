---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	supervisor(supervisor)
	dispatch(dispatch)
	research(research)
	data(data)
	summary(summary)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> supervisor;
	data --> dispatch;
	dispatch -.-> data;
	dispatch -.-> finalize;
	dispatch -.-> research;
	dispatch -.-> summary;
	research --> dispatch;
	summary --> dispatch;
	supervisor --> dispatch;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
