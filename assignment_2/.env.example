# LLM providers — model IDs verified on each provider's docs on 2026-10-27.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Create this key with a personal Gmail account, not @usc.edu (Piazza #137).
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi (Moonshot, China endpoint): last-resort backup for every agent when primary and fallback both fail.
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Tavily Remote MCP; the key is passed as the tavilyApiKey query parameter of the MCP URL (PDF §3.4).
TAVILY_API_KEY=tvly-your-key-here

# Runtime
CHROMA_PERSIST_DIR=chroma_index
MEDALS_DB_PATH=data/medals.sqlite
RETRIEVAL_K=5
WEB_ENABLED=true
PORT=8080

# Deployment (deploy.sh)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=ultimate-assistant
