# NVIDIA NIM uses an OpenAI-compatible API.
OPENAI_API_KEY=nvapi-your-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Recommended for reliable Tavily searches during grading.
TAVILY_API_KEY=tvly-your-key-here

# Runtime settings. These defaults work locally and on Cloud Run.
MCP_FILES_ROOT=workspace
AGENT_TIMEOUT_SECONDS=90
PORT=8080

# Deployment settings used by deploy.sh.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=csci599-a1
